{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cheese Corner POS",
  "version": "1.0.0",
  "identifier": "com.cheesecorner.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8080/windows-pos",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cheese Corner — Windows Counter POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
